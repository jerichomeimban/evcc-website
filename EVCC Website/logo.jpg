<h2 class="title">Contact Us</h2>
<p class="subtitle">For inquiries, visit or contact Eastern Visayas Central Colleges.</p>
<div class="grid">
<div class="card"><div class="card-body"><h3>School Information</h3><p><strong>School:</strong> Eastern Visayas Central Colleges</p><p><strong>Address:</strong> Catarman, Northern Samar</p><p><strong>Phone:</strong> 0000000000</p><p><a href="https://www.facebook.com/profile.php?id=61577088823683" target="_blank">Visit Official Facebook Page</a></p></div></div>
<div class="card"><div class="card-body"><h3>Inquiry Form</h3><form class="form" name="contact" method="POST" data-netlify="true"><input type="text" name="name" placeholder="Full Name"><input type="email" name="email" placeholder="Email Address"><textarea name="message" rows="5" placeholder="Message"></textarea><button type="submit">Send Message</button></form></div></div>
</div>
