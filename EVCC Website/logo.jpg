<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Eastern Visayas Central Colleges</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f5f6f7;color:#222}
.topbar{background:#5b0010;color:white;padding:8px 6%;text-align:right;font-size:14px}
header{background:white;padding:18px 6%;display:flex;align-items:center;justify-content:space-between;box-shadow:0 2px 8px rgba(0,0,0,.08);position:sticky;top:0;z-index:5}
.brand{display:flex;align-items:center;gap:14px}
.brand img{width:78px;height:78px;object-fit:contain}
.brand h1{margin:0;color:#7b0015}
.brand p{margin:3px 0 0;color:#555;font-weight:bold}
nav a{margin-left:16px;text-decoration:none;color:#222;font-weight:bold}
.apply{background:#f4a51c;color:#5b0010;padding:12px 16px;border-radius:4px}
.admin{background:#222;color:white;padding:12px 16px;border-radius:4px}
.hero{background:linear-gradient(rgba(91,0,16,.88),rgba(91,0,16,.88));padding:85px 6%;color:white;display:grid;grid-template-columns:1.3fr .7fr;gap:30px;align-items:center}
.hero h2{font-size:50px;margin:0 0 15px}
.hero p{font-size:21px;line-height:1.5}
.hero a{display:inline-block;background:#f4a51c;color:#5b0010;padding:15px 25px;margin-top:15px;text-decoration:none;font-weight:bold;border-radius:4px}
.hero-logo{background:white;border-radius:18px;padding:25px;max-width:330px;margin:auto;box-shadow:0 10px 30px rgba(0,0,0,.25)}
.hero-logo img{width:100%}
.quick{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));margin:-35px 6% 30px;position:relative}
.quick div{background:white;padding:25px;box-shadow:0 4px 14px rgba(0,0,0,.12)}
.quick h3,.title,.card h3{color:#7b0015}
section{padding:50px 6%}
.title{font-size:34px;margin-bottom:10px}
.grid,.gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:22px}
.card,.gallery-card{background:white;border-radius:8px;overflow:hidden;box-shadow:0 3px 12px rgba(0,0,0,.10)}
.card .stripe{height:8px;background:#f4a51c}
.card div,.gallery-caption{padding:22px}
.gallery-card img{width:100%;height:260px;object-fit:cover;object-position:top}
.banner{background:#7b0015;color:white;text-align:center;padding:45px 6%}
.contact,.vm{background:white}
.fb-btn{display:inline-block;background:#1877f2;color:white;padding:13px 20px;text-decoration:none;border-radius:5px;font-weight:bold}
footer{background:#2a2a2a;color:white;padding:35px 6%;display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:25px}
footer h3{color:#f4a51c}
@media(max-width:850px){header{display:block;text-align:center}.brand{justify-content:center}nav a{display:inline-block;margin:8px}.hero{grid-template-columns:1fr;text-align:center}.hero h2{font-size:36px}.gallery-card img{height:auto}}
</style>
</head>
<body>
<div class="topbar">Catarman, Northern Samar | Eastern Visayas Central Colleges</div>
<header>
  <div class="brand">
    <img src="assets/images/logo.jpg" alt="EVCC Logo">
    <div><h1>EVCC</h1><p>Eastern Visayas Central Colleges</p></div>
  </div>
  <nav>
    <a href="#programs">Programs</a>
    <a href="#vision">Vision</a>
    <a href="#news">News</a>
    <a href="#gallery">Gallery</a>
    <a href="#contact">Contact</a>
    <a class="apply" href="#admission">Apply Now</a>
    <a class="admin" href="/admin/">Admin</a>
  </nav>
</header>

<section class="hero">
  <div>
    <h2>Start your future at Eastern Visayas Central Colleges</h2>
    <p>Quality education, leadership, discipline, and community service in Catarman, Northern Samar.</p>
    <a href="#programs">Explore Programs</a>
  </div>
  <div class="hero-logo"><img src="assets/images/logo.jpg" alt="EVCC Logo"></div>
</section>

<div class="quick">
  <div><h3>Apply</h3><p>Begin your admission journey at EVCC.</p></div>
  <div><h3>Visit</h3><p>Located in Catarman, Northern Samar.</p></div>
  <div><h3>Criminology</h3><p>Career-focused education for service and leadership.</p></div>
  <div><h3>Student Life</h3><p>Build confidence, discipline, and teamwork.</p></div>
</div>

<section id="programs">
  <h2 class="title">Programs</h2>
  <div class="grid">
    <div class="card"><div class="stripe"></div><div><h3>Criminology</h3><p>Prepare for careers in law enforcement, public safety, investigation, corrections, and community service.</p></div></div>
    <div class="card"><div class="stripe"></div><div><h3>Senior High School</h3><p>Build a strong academic foundation for college and career success.</p></div></div>
    <div class="card"><div class="stripe"></div><div><h3>Student Development</h3><p>Develop leadership, discipline, responsibility, and professionalism.</p></div></div>
  </div>
</section>

<section id="vision" class="vm">
  <h2 class="title">Vision & Mission</h2>
  <div class="grid">
    <div class="card"><div><h3>Vision</h3><p>To become a respected educational institution in Eastern Visayas that develops skilled, disciplined, and service-oriented graduates.</p></div></div>
    <div class="card"><div><h3>Mission</h3><p>To provide quality and accessible education through strong academic instruction, values formation, leadership training, and community service.</p></div></div>
  </div>
</section>

<section id="gallery">
  <h2 class="title">Campus Gallery</h2>
  <div class="gallery">
    <div class="gallery-card"><img src="assets/images/library.png" alt="EVCC Library"><div class="gallery-caption"><h3>EVCC Library</h3><p>Learning resources and study area for students.</p></div></div>
    <div class="gallery-card"><img src="assets/images/bsis-lab.png" alt="BSIS Laboratory"><div class="gallery-caption"><h3>BSIS Laboratory</h3><p>Computer laboratory and technology learning space.</p></div></div>
  </div>
</section>

<section id="news">
  <h2 class="title">News & Announcements</h2>
  <div class="grid">
    <div class="card"><div><h3>Enrollment Updates</h3><p>Visit the school office or Facebook page for enrollment updates and requirements.</p></div></div>
    <div class="card"><div><h3>School Events</h3><p>Follow official announcements for events, activities, and important dates.</p></div></div>
  </div>
</section>

<section id="admission" class="banner">
  <h2>Admissions are open</h2>
  <p>Join Eastern Visayas Central Colleges and take the next step toward your future.</p>
</section>

<section id="contact" class="contact">
  <h2 class="title">Contact Us</h2>
  <p><strong>School:</strong> Eastern Visayas Central Colleges</p>
  <p><strong>Address:</strong> Catarman, Northern Samar</p>
  <p><strong>Phone:</strong> 0000000000</p>
  <a class="fb-btn" href="https://www.facebook.com/profile.php?id=61577088823683" target="_blank">Visit Facebook Page</a>
</section>

<footer>
  <div><h3>EVCC</h3><p>Eastern Visayas Central Colleges</p><p>EST. 2000</p></div>
  <div><h3>Quick Links</h3><p>Programs</p><p>Admissions</p><p>News & Events</p></div>
  <div><h3>Location</h3><p>Catarman, Northern Samar</p></div>
</footer>
</body>
</html>
